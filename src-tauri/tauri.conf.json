{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crosshair Studio",
  "version": "1.0.0",
  "identifier": "com.crosshairstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Crosshair Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#101014",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Crosshair Studio",
    "copyright": "Copyright © 2026 Crosshair Studio",
    "category": "Utility",
    "shortDescription": "Crosshair overlay for Windows",
    "longDescription": "Crosshair Studio creates, customizes and displays a crosshair or a center dot on top of your screen, without touching any game process.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "French"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "language": ["en-US", "fr-FR"]
      }
    }
  }
}
